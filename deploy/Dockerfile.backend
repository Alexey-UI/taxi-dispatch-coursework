FROM golang:1.26.10-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /taxi ./cmd/taxi
FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 taxi
COPY --from=build /taxi /usr/local/bin/taxi
USER 10001
EXPOSE 8080
ENTRYPOINT ["taxi"]
